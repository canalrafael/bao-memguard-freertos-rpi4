#!/bin/sh
# /etc/init.d/S99ataques
#
# Cenários de ataque:
#   - Cenário 6: Ciclo contínuo Spectre → Armageddon → Meltdown → repete
#   - Cenário 7: Ciclo com idle: sem_ataque → Spectre → Armageddon → Meltdown → repete
#
# O label é passado como argumento para ipc_sync e escrito via ipc_signal.
# Configuração do modo (com ou sem idle) é feita via /root/attack_mode.cfg

# Configurações
LOGFILE="/tmp/ataques.log"
ATTACK_DURATION=600   # 10 minutos (600s)
SYNC_INTERVAL=15      # 15s

# Labels únicos por ataque (para diferenciar no CSV)
# Benchmarks usam 1-7, ataques começam em 10
L_IDLE=0
L_SPECTRE=10
L_ARMAGEDDON=11
L_MELTDOWN=12

# Arquivo de pid
PIDFILE="/var/run/ataques.pid"

# Arquivo de configuração do modo (criado pelo build conforme o cenário)
MODE_FILE="/root/attack_mode.cfg"

run_attacks() {
    # Detecta modo: "with_idle" ou "no_idle"
    MODE="no_idle"
    if [ -f $MODE_FILE ]; then
        MODE=$(cat $MODE_FILE)
    fi

    echo "[VM3] Iniciando orquestrador de ataques (modo=$MODE, spectre=$L_SPECTRE armageddon=$L_ARMAGEDDON meltdown=$L_MELTDOWN)..." | tee $LOGFILE > /dev/console

    while true; do
        if [ "$MODE" = "with_idle" ]; then
            # --- IDLE → SPECTRE → IDLE → ARMAGEDDON → IDLE → MELTDOWN ---
            run_idle_for $L_IDLE
            run_attack_for "/root/spectre" "Spectre" $L_SPECTRE

            run_idle_for $L_IDLE
            run_attack_for "/root/armageddon" "Armageddon" $L_ARMAGEDDON

            run_idle_for $L_IDLE
            run_attack_for "/root/meltdown" "Meltdown" $L_MELTDOWN
        else
            # --- SPECTRE → ARMAGEDDON → MELTDOWN (sem idle) ---
            run_attack_for "/root/spectre" "Spectre" $L_SPECTRE
            run_attack_for "/root/armageddon" "Armageddon" $L_ARMAGEDDON
            run_attack_for "/root/meltdown" "Meltdown" $L_MELTDOWN
        fi
    done
}

run_idle_for() {
    LABEL=$1

    echo "[VM3] >> Fase IDLE (sem ataque) por $(($ATTACK_DURATION / 60)) minutos (label=$LABEL)..." | tee -a $LOGFILE > /dev/console
    
    # Escreve o label idle no IPC
    /root/ipc_signal write 8 $LABEL

    # Conta o tempo total
    TIME_ELAPSED=0

    # Apenas dorme e sincroniza — nenhum ataque rodando
    while [ $TIME_ELAPSED -lt $ATTACK_DURATION ]; do
        sleep $SYNC_INTERVAL

        # Sincroniza via ipc_sync: envia label, sinaliza VM0, espera VM0 liberar
        /root/ipc_sync $LABEL

        TIME_ELAPSED=$(($TIME_ELAPSED + $SYNC_INTERVAL))
    done
}

run_attack_for() {
    BIN_PATH=$1
    NAME=$2
    LABEL=$3

    echo "[VM3] >> Rodando $NAME por $(($ATTACK_DURATION / 60)) minutos (label=$LABEL)..." | tee -a $LOGFILE > /dev/console
    
    # Escreve o label do ataque no IPC antes de iniciar
    # offset 8 = current_label no IPC_Channel
    /root/ipc_signal write 8 $LABEL
    
    # Inicia o ataque em background
    $BIN_PATH &
    ATTACK_PID=$!

    # Conta o tempo total já gasto no ataque
    TIME_ELAPSED=0

    # Enquanto nao atingir o tempo total do ataque, fazemos intervalos de SYNC_INTERVAL
    while [ $TIME_ELAPSED -lt $ATTACK_DURATION ]; do
        sleep $SYNC_INTERVAL
        
        # Pausa o ataque
        kill -STOP $ATTACK_PID 2>/dev/null

        # Sincroniza via ipc_sync: envia label específico, sinaliza VM0, espera VM0 liberar
        /root/ipc_sync $LABEL

        # Retoma o ataque
        kill -CONT $ATTACK_PID 2>/dev/null
        
        TIME_ELAPSED=$(($TIME_ELAPSED + $SYNC_INTERVAL))
    done

    # Terminou o tempo do ataque, mata ele
    kill -9 $ATTACK_PID 2>/dev/null
    wait $ATTACK_PID 2>/dev/null
}

case "$1" in
  start)
        echo "Starting ataques script"
        if [ -f $PIDFILE ]; then
            echo "Already running."
            exit 1
        fi
        # Verifica se DEV mem ta acessivel
        if [ ! -c /dev/mem ]; then
            echo "AVISO: /dev/mem não encontrado! IPC falhará." | tee -a $LOGFILE > /dev/console
        fi
        # Executa a função em background para não travar o boot
        run_attacks &
        echo $! > $PIDFILE
        ;;
  stop)
        echo "Stopping ataques script"
        if [ -f $PIDFILE ]; then
            PID=$(cat $PIDFILE)
            kill $PID
            rm -f $PIDFILE
            # mata os binarios tambem
            killall spectre armageddon meltdown 2>/dev/null
        else
            echo "Not running"
        fi
        ;;
  restart|reload)
        $0 stop
        $0 start
        ;;
  *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
exit 0
