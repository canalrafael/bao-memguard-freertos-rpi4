#!/bin/sh
# /etc/init.d/S99ataques
#
# Cenário de coleta:
#   - Se rodando sozinho (cenário 2): label = 1
#   - Se rodando junto com benchmarks (cenário 3): label = 3
#
# O label é passado como argumento para ipc_sync.
# Para trocar o cenário, altere L_ATTACK abaixo.

# Configurações
LOGFILE="/tmp/ataques.log"
ATTACK_DURATION=600   # 10 minutos (600s)
SYNC_INTERVAL=15      # 15s

# Label único para TODOS os ataques
# Cenário 2 (solo ataques): usar 1
# Cenário 3 (bench + ataques): usar 3
L_ATTACK=1

# Arquivo de pid
PIDFILE="/var/run/ataques.pid"

run_attacks() {
    echo "[VM3] Iniciando orquestrador de ataques (label=$L_ATTACK)..." | tee $LOGFILE > /dev/console

    while true; do
        # --- SPECTRE ---
        run_attack_for "/root/spectre" "Spectre"
        
        # --- ARMAGEDDON ---
        run_attack_for "/root/armageddon" "Armageddon"
        
        # --- MELTDOWN ---
        run_attack_for "/root/meltdown" "Meltdown"
    done
}

run_attack_for() {
    BIN_PATH=$1
    NAME=$2

    echo "[VM3] >> Rodando $NAME por $(($ATTACK_DURATION / 60)) minutos (label=$L_ATTACK)..." | tee -a $LOGFILE > /dev/console
    
    # Inicia o ataque em background
    $BIN_PATH &
    ATTACK_PID=$!

    # Conta o tempo total já gasto no ataque
    TIME_ELAPSED=0

    # Enquanto nao atingir o tempo total do ataque, fazemos intervalos de SYNC_INTERVAL
    while [ $TIME_ELAPSED -lt $ATTACK_DURATION ]; do
        sleep $SYNC_INTERVAL
        
        # Pausa o ataque
        kill -STOP $ATTACK_PID 2>/dev/null

        # Sincroniza via ipc_sync: envia label ÚNICO, sinaliza VM0, espera VM0 liberar
        /root/ipc_sync $L_ATTACK

        # Retoma o ataque
        kill -CONT $ATTACK_PID 2>/dev/null
        
        TIME_ELAPSED=$(($TIME_ELAPSED + $SYNC_INTERVAL))
    done

    # Terminou o tempo do ataque, mata ele
    kill -9 $ATTACK_PID 2>/dev/null
    wait $ATTACK_PID 2>/dev/null
}

case "$1" in
  start)
        echo "Starting ataques script"
        if [ -f $PIDFILE ]; then
            echo "Already running."
            exit 1
        fi
        # Verifica se DEV mem ta acessivel
        if [ ! -c /dev/mem ]; then
            echo "AVISO: /dev/mem não encontrado! IPC falhará." | tee -a $LOGFILE > /dev/console
        fi
        # Executa a função em background para não travar o boot
        run_attacks &
        echo $! > $PIDFILE
        ;;
  stop)
        echo "Stopping ataques script"
        if [ -f $PIDFILE ]; then
            PID=$(cat $PIDFILE)
            kill $PID
            rm -f $PIDFILE
            # mata os binarios tambem
            killall spectre armageddon meltdown 2>/dev/null
        else
            echo "Not running"
        fi
        ;;
  restart|reload)
        $0 stop
        $0 start
        ;;
  *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
exit 0
