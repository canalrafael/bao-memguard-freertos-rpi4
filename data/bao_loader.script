verbose on
log on

# Wait for autoboot prompt
expect "Hit any key to stop autoboot:  2"
send " "

# Wait for U-Boot prompt
expect "U-Boot>"
send "fatload mmc 0 0x200000 bao-${BAO_INDEX}.bin; go 0x200000\r"

# Wait for program completion
expect "end iteration"

log off
send "\r\n"   # flush final line
sleep 0.5     # give the terminal time to render

! killall -9 minicom
